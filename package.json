{
  "name": "uk.ac.ceh.esurveyor",
  "version": "2.0.0",
  "title": "e-Surveyor",
  "scripts": {
    "prepare": "husky",
    "start": "webpack serve --progress --port 8000",
    "build": "NODE_ENV=production webpack",
    "build:production": "npm run clean && npm run build && npx cap sync && npm run build:resources",
    "build:resources": "mkdir -p resources && cp -R other/designs/android resources && cp -R other/designs/*.png resources && npx cordova-res ios --skip-config --resources resources --copy && npx cordova-res android --skip-config --resources resources --copy",
    "deploy": "cp other/demo.html build/ && URL=$(vercel --prod -t $VERCEL_TOKEN --yes -A ./other/vercel.json ./build) && CLEAN_URL=$(echo $URL | sed -r \"s/https:\\/\\/(.*)$/\\1/g\") && DEMO_URL=$(echo $CLEAN_URL | sed -r \"s/(.*\\-)[a-z0-9]+\\-flumens(\\.vercel\\.app)$/\\1${BITRISE_BUILD_NUMBER}\\2/g\") && envman add --key DEMO_URL --value \"https://$DEMO_URL\"",
    "deploy:production": "bitrise run ci",
    "clean": "rm -rf build resources",
    "test": "jest --silent --passWithNoTests",
    "test:watch": "jest --watchAll",
    "check": "npx tsc --noEmit --skipLibCheck && npm run test:eslint",
    "test:eslint": "eslint src --quiet && echo '\\033[37;42;1m PASS \\033[00m'",
    "test:acceptance": "cd other && newman run postman_collection.json --bail --env-var plantnet_api_key=${PLANT_NET_API_KEY}",
    "make:all": "npm run make:data && npm run make:species:data && npm run make:species:commonNames",
    "make:data": "cd src/common/data && tsx make.ts",
    "make:data:moths": "cd src/common/data/moths && tsx make.ts",
    "make:data:species": "cd src/common/data/species && tsx make.ts",
    "make:data:commonNames": "cd src/common/data/commonNames && tsx make.ts"
  },
  "dependencies": {
    "@babel/runtime-corejs3": "8.0.0",
    "@capacitor-community/sqlite": "8.1.0",
    "@capacitor/android": "8.4.2",
    "@capacitor/app": "8.1.1",
    "@capacitor/camera": "8.2.1",
    "@capacitor/core": "8.4.2",
    "@capacitor/device": "8.0.3",
    "@capacitor/filesystem": "8.1.2",
    "@capacitor/geolocation": "8.2.0",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.4.2",
    "@capacitor/keyboard": "8.0.5",
    "@capacitor/network": "8.0.1",
    "@capacitor/share": "8.0.1",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.3",
    "@flumens/bigu": "0.4.1",
    "@flumens/ionic": "2.0.0-alpha.106",
    "@flumens/models": "0.28.0",
    "@flumens/tailwind": "0.42.0",
    "@flumens/utils": "0.12.0",
    "@hookform/resolvers": "5.4.0",
    "@ionic-native/core": "5.36.0",
    "@ionic/core": "8.8.15",
    "@ionic/react": "8.8.15",
    "@ionic/react-router": "8.8.15",
    "@react-stately/form": "^3.3.1",
    "@sentry/browser": "10.67.0",
    "@techstark/opencv-js": "5.0.0-release.1",
    "@turf/bbox": "^7.3.5",
    "@turf/distance": "^7.3.5",
    "@types/deep-diff": "1.0.5",
    "@types/geojson": "^7946.0.16",
    "@types/mapbox-gl": "^3.5.0",
    "axios": "1.18.1",
    "capacitor-blob-writer": "1.1.20",
    "chart.js": "4.5.1",
    "clsx": "2.1.1",
    "deep-diff": "1.0.2",
    "drizzle-orm": "0.45.2",
    "i18next": "26.3.6",
    "ionicons": "8.0.13",
    "jeep-sqlite": "2.8.0",
    "jwt-decode": "4.0.0",
    "lodash": "4.18.1",
    "mapbox-gl": "^3.27.0",
    "mobx": "6.16.1",
    "mobx-react": "9.2.2",
    "mobx-utils": "6.1.1",
    "react": "19.2.8",
    "react-chartjs-2": "5.3.1",
    "react-countup": "6.5.3",
    "react-dom": "19.2.8",
    "react-easy-crop": "6.2.2",
    "react-hook-form": "7.82.0",
    "react-i18next": "17.0.11",
    "react-map-gl": "^8.1.1",
    "react-router": "5.3.4",
    "react-router-dom": "5.3.4",
    "react-window": "2.3.0",
    "sql.js": "1.12.0",
    "swiper": "14.0.6",
    "swr": "2.4.2",
    "wellknown": "^0.5.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@babel/core": "8.0.1",
    "@babel/plugin-transform-exponentiation-operator": "8.0.1",
    "@babel/plugin-transform-runtime": "8.0.1",
    "@babel/preset-env": "8.0.2",
    "@babel/preset-react": "8.0.1",
    "@babel/preset-typescript": "8.0.1",
    "@capacitor/cli": "8.4.2",
    "@flumens/eslint-config": "3.0.2",
    "@flumens/fetch-onedrive-excel": "0.3.4",
    "@flumens/prettier-config": "0.4.0",
    "@flumens/webpack-config": "6.2.0",
    "@types/jest": "^30.0.0",
    "@types/lodash": "4.17.24",
    "@types/node": "^26.1.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/react-router": "5.1.20",
    "@types/react-router-dom": "5.3.3",
    "@types/wellknown": "^0.5.8",
    "babel-jest": "30.4.1",
    "babel-plugin-module-resolver": "5.0.3",
    "babel-plugin-polyfill-corejs3": "1.0.0",
    "copy-webpack-plugin": "14.0.0",
    "cordova-res": "0.15.4",
    "dotenv": "17.4.2",
    "eslint": "9.39.4",
    "husky": "9.1.7",
    "jest": "30.4.2",
    "jest-environment-jsdom": "30.4.1",
    "jest-transform-stub": "2.0.0",
    "mock-geolocation": "1.0.11",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "vercel": "56.5.0",
    "webpack": "5.108.4",
    "webpack-cli": "7.2.1",
    "webpack-dev-server": "6.0.0"
  },
  "engines": {
    "node": ">=22.18",
    "npm": ">=10"
  },
  "author": {
    "name": "Flumens",
    "email": "enquiries@flumens.io",
    "url": "https://flumens.io"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/NERC-CEH/e-surveyor-app"
  },
  "bugs": {
    "url": "https://github.com/NERC-CEH/e-surveyor-app/issues"
  },
  "licenses": [
    {
      "type": "GNU GPL v3",
      "url": "http://www.gnu.org/licenses/gpl.html"
    }
  ],
  "keywords": [
    "biological",
    "recording",
    "mobile",
    "app",
    "offline",
    "ceh"
  ],
  "babel": {
    "presets": [
      "@babel/preset-react",
      "@babel/preset-env",
      "@babel/preset-typescript"
    ],
    "plugins": [
      "@babel/plugin-transform-runtime",
      [
        "babel-plugin-polyfill-corejs3",
        {
          "method": "usage-global",
          "version": "3.46"
        }
      ],
      [
        "module-resolver",
        {
          "root": [
            "./src"
          ],
          "alias": {
            "@flumens$": "./src/common/flumens",
            "common": "./src/common",
            "helpers": "./src/common/helpers",
            "models": "./src/common/models",
            "Components": "./src/common/Components"
          }
        }
      ],
      "@babel/plugin-transform-exponentiation-operator"
    ]
  },
  "prettier": "@flumens/prettier-config",
  "jest": {
    "testEnvironment": "jsdom",
    "transform": {
      "^.+\\.(t|j)sx?$": [
        "babel-jest",
        {
          "presets": [
            "@babel/env"
          ]
        }
      ]
    },
    "testRegex": "src.*((\\.|/*.)(spec))\\.(t|j)s?$",
    "moduleNameMapper": {
      "^.+.(css|style|less|sass|scss|svg|png|jpg|ttf|woff|woff2)$": "jest-transform-stub",
      "ionic-native": "jest-transform-stub",
      "ionicons/components/ion-icon.js": "@ionic/core/components/ion-icon.js",
      "swiper": "jest-transform-stub",
      "\\?react$": "jest-transform-stub"
    },
    "moduleDirectories": [
      "node_modules",
      "components",
      "src"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/test/setupTests.js"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!@ionic|@stencil|ionicons|@mapbox|@flumens|nanoid)"
    ]
  }
}
